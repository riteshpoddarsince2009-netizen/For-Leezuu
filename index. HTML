<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>For Leezuu 😉</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background: linear-gradient(135deg, #1f1c2c, #928dab);
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            position: relative;
        }
        /* Floating Hearts Animation */
        .heart-bg {
            position: absolute;
            font-size: 20px;
            color: rgba(255, 75, 122, 0.4);
            animation: floatUp 5s linear infinite;
            bottom: -20px;
            z-index: 1;
        }
        @keyframes floatUp {
            0% { transform: translateY(0) rotate(0deg); opacity: 1; }
            100% { transform: translateY(-105vh) rotate(360deg); opacity: 0; }
        }
        .card {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 40px;
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
            text-align: center;
            max-width: 450px;
            width: 90%;
            z-index: 10;
            transition: all 0.5s ease;
        }
        h1 {
            color: #fff;
            font-size: 28px;
            margin-bottom: 15px;
            text-shadow: 0 2px 10px rgba(255, 75, 122, 0.5);
        }
        p {
            color: #e0e0e0;
            font-size: 16px;
            margin-bottom: 30px;
            line-height: 1.5;
        }
        .btn-container {
            display: flex;
            justify-content: center;
            gap: 20px;
            position: relative;
            height: 50px;
        }
        .btn {
            padding: 12px 35px;
            font-size: 16px;
            font-weight: bold;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }
        #yesBtn {
            background: linear-gradient(45deg, #ff4b7a, #ff758c);
            color: white;
        }
        #yesBtn:hover {
            transform: scale(1.1);
            box-shadow: 0 6px 20px rgba(255, 75, 122, 0.6);
        }
        #noBtn {
            background: #fff;
            color: #333;
            position: absolute;
            right: 40px;
        }
    </style>
</head>
<body>

    <div class="card" id="mainCard">
        <h1 id="title">Suna hai class me bohot natak chalta hai, Leezuu? 😉</h1>
        <p id="desc">Ritam toh bol raha tha ki tum sabke samne bade maza le rahi ho... Toh chalo, ab chupchaap yahan accept karo, jidd band karo! 😂</p>
        <div class="btn-container" id="btnContainer">
            <button class="btn" id="yesBtn" onclick="celebrate()">YES 💖</button>
            <button class="btn" id="noBtn" onmouseover="moveNoButton()" onclick="moveNoButton()">NO 😜</button>
        </div>
    </div>

    <script>
        // Background elements (Hearts)
        function createHeart() {
            const heart = document.createElement('div');
            heart.classList.add('heart-bg');
            heart.innerHTML = '❤️';
            heart.style.left = Math.random() * 100 + 'vw';
            heart.style.animationDuration = Math.random() * 2 + 3 + 's';
            heart.style.fontSize = Math.random() * 20 + 10 + 'px';
            document.body.appendChild(heart);
            setTimeout(() => { heart.remove(); }, 5000);
        }
        setInterval(createHeart, 300);

        // Runaway NO button logic
        function moveNoButton() {
            const noBtn = document.getElementById('noBtn');
            const container = document.getElementById('btnContainer');
            
            const maxX = container.clientWidth - noBtn.clientWidth;
            const maxY = 300; 
            
            const randomX = Math.floor(Math.random() * (maxX + 100)) - 50;
            const randomY = Math.floor(Math.random() * maxY) - 150;

            noBtn.style.left = randomX + 'px';
            noBtn.style.top = randomY + 'px';
        }

        // YES Button Explosion logic
        function celebrate() {
            const card = document.getElementById('mainCard');
            
            card.style.transform = 'scale(0.9)';
            setTimeout(() => {
                card.style.transform = 'scale(1)';
                card.style.background = 'rgba(255, 75, 122, 0.2)';
                document.getElementById('title').innerHTML = '🏆 Leezuu Has Accepted! 👑';
                document.getElementById('desc').innerHTML = 'Chalo, ab saara natak aur doston ke samne chidhane ka game khatam! Ritam ko bol do ki Ritesh ne officially website par tumhara natak pakad liya hai. Ab agli baar tuition me chupchaap seedhe aana! 😉✨';
                document.getElementById('btnContainer').style.display = 'none';
                
                for(let i=0; i<50; i++) {
                    setTimeout(createHeart, i * 20);
                }
            }, 300);
        }
    </script>
</body>
</html>
